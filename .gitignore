__pycache__/
*.pyc
.venv/
.pytest_cache/
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.fdb_latexmk
paper/main.fls
paper/main.log
paper/main.out
paper/build*.log

# Secrets — never tracked; the VPS copy relies on this too
.env
