% Minimal float wrapper for the `algorithm` environment (local vendored replacement for the
% CTAN `algorithms` package's algorithm.sty, which ships only as dtx source). Provides exactly
% what main.tex uses: a top-placeable float named "Algorithm" with \caption support.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{algorithm}[2026/07/11 local minimal algorithm float]
\RequirePackage{float}
\floatstyle{ruled}
\newfloat{algorithm}{htbp}{loa}
\floatname{algorithm}{Algorithm}
\newcommand{\listofalgorithms}{\listof{algorithm}{List of Algorithms}}
\endinput
